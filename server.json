 "homepage": "https://savantcat.cn/geo-check.html",
 "repository": {
  "type": "git",
  "url": "https://github.com/savantcat/mcp-geo-cn"
 },
 "runtime": {
  "type": "python",
  "entry": "server.py",
  "args": [
   "--transport",
   "http",
   "--host",
   "127.0.0.1",
   "--port",
   "8767",
   "--stateless"
  ]
 },
 "tools": [
  "audit_cn_citability",
  "probe_source_pool",
  "score_visibility",
  "plan_fixes"
 ]
}